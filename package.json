{
  "name": "majiflow-app",
  "version": "1.0.0",
  "description": "MajiFlow — water orchestration configurator",
  "main": "dist-electron/electron/main.js",
  "workspaces": ["packages/*"],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dev": "npm run build:electron && concurrently \"ng serve\" \"wait-on http://localhost:4200 && electron .\"",
    "package": "ng build --configuration production && npm run build:electron && electron-builder",
    "package:linux": "ng build --configuration production && npm run build:electron && electron-builder --linux",
    "package:win": "ng build --configuration production && npm run build:electron && electron-builder --win",
    "package:mac": "ng build --configuration production && npm run build:electron && electron-builder --mac",
    "test": "npx tsx test/codegen.test.ts",
    "test:db": "npx tsx test/db.test.ts",
    "test:limits": "npx tsx test/limits.test.ts",
    "test:topology": "npx tsx test/topology.test.ts",
    "postinstall": "electron-builder install-app-deps"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.7",
    "@angular/compiler": "^21.2.7",
    "@angular/core": "^21.2.7",
    "@angular/forms": "^21.2.7",
    "@angular/platform-browser": "^21.2.7",
    "@angular/router": "^21.2.7",
    "@antv/x6": "^2.19.2",
    "@antv/x6-plugin-export": "^2.1.6",
    "@antv/x6-plugin-history": "^2.2.4",
    "@antv/x6-plugin-minimap": "^2.0.7",
    "@antv/x6-plugin-selection": "^2.2.2",
    "@antv/x6-plugin-snapline": "^2.1.7",
    "handlebars": "^4.7.9",
    "rxjs": "~7.8.0",
    "sql.js": "^1.14.1",
    "tslib": "^2.3.0",
    "yaml": "^2.8.3",
    "zod": "^3.25.76",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.6",
    "@angular/cli": "^21.2.6",
    "@angular/compiler-cli": "^21.2.6",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.2",
    "@types/sql.js": "^1.4.11",
    "concurrently": "^9.2.1",
    "daisyui": "^5.5.19",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.2",
    "wait-on": "^9.0.4"
  }
}

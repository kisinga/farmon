{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./dist-electron",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "paths": {
      "@far-mon/core": ["./packages/core/src/index.ts"]
    }
  },
  "include": [
    "electron/**/*.ts",
    "packages/core/src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}

# MajiFlow server configuration. Copy to `.env` and fill in.
# Infra/runtime config is env (this file); business rules (e.g. the managed
# device cap) live in the app_config DB collection, tuned from the admin UI.
#
# Pick ONE profile below. The MAJI_MQTT_PUBLIC_* trio is what gets baked into
# generated firmware, so it must point at whatever device-facing listener is
# actually serving (and match its TLS setting).

# ── App admin (the SPA login, role=admin) ────────────────────────────────────
# Seeded once on first boot if the user doesn't exist. Use the UI afterwards.
MAJI_ADMIN_EMAIL=admin@example.com
MAJI_ADMIN_PASSWORD=change-me-long-random

# ── PocketBase superuser (the /_/ dashboard login) ───────────────────────────
# Bootstrapped idempotently by the entrypoint. Distinct from the app admin above.
MAJI_SUPERUSER_EMAIL=super@example.com
MAJI_SUPERUSER_PASSWORD=change-me-long-random


# ═══ Profile A: Managed cloud (TLS, internet-facing) ═════════════════════════
MAJI_MQTT_TLS_ENABLED=true
MAJI_MQTT_TLS=:8883
MAJI_MQTT_TLS_CERT=/certs/fullchain.pem
MAJI_MQTT_TLS_KEY=/certs/privkey.pem
# Device-facing endpoint baked into firmware (the host devices dial out to):
MAJI_MQTT_PUBLIC_HOST=mqtt.majiflow.io
MAJI_MQTT_PUBLIC_PORT=8883
# When true, generated firmware does verified TLS: the server reads the broker's single
# self-signed cert from MAJI_MQTT_TLS_CERT (fullchain.pem) and bakes it in as the
# device's pinned certificate_authority. Devices pin that exact cert (esp-idf mbedTLS
# rejects a two-tier CA chain), so replacing the cert re-flashes the fleet.
MAJI_MQTT_PUBLIC_TLS=true

# ═══ Profile B: On-prem / edge (plain MQTT on the LAN, no certs) ══════════════
# Comment out Profile A above and use these instead — no certificate needed.
# MAJI_MQTT_TLS_ENABLED=false
# MAJI_MQTT_PUBLIC_HOST=192.168.1.10   # the box's LAN IP devices can reach
# MAJI_MQTT_PUBLIC_PORT=1883
# MAJI_MQTT_PUBLIC_TLS=false


# ── Email alerts (optional) ──────────────────────────────────────────────────
# Outbound email (controller offline, tank thresholds, faults) uses PocketBase's
# built-in mailer. Configure SMTP in the PB superuser dashboard at /_/ → Settings
# → Mail (host, port, credentials, sender). Until it's enabled there, email stays
# off and the in-app alerts center works on its own. A user only gets email after
# opting in on their account page.

# ── Broker bind addresses (rarely changed) ───────────────────────────────────
# Where the broker LISTENS inside the container (not the device-facing host).
# MAJI_MQTT_TCP=:1883   # plain MQTT
# MAJI_MQTT_WS=:8082    # browser MQTT-over-WS (unused by the SPA today)

# MAJI_SPA_DIR is baked into the image (/app/spa) — do not set here.

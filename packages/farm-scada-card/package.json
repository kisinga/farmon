{
  "name": "@far-mon/farm-scada-card",
  "version": "0.1.0",
  "description": "Lit-based Home Assistant custom card that renders MajiFlow SCADA topologies (SVG + meta) with live state, per-node menus, and pipe flow animation.",
  "type": "module",
  "main": "dist/farm-scada-card.js",
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild src/farm-scada-card.ts --bundle --minify --format=esm --target=es2020 --outfile=dist/farm-scada-card.js --sourcemap",
    "build:dev": "esbuild src/farm-scada-card.ts --bundle --format=esm --target=es2020 --outfile=dist/farm-scada-card.js --sourcemap",
    "watch": "esbuild src/farm-scada-card.ts --bundle --format=esm --target=es2020 --outfile=dist/farm-scada-card.js --sourcemap --watch",
    "test": "npx tsx test/card.test.ts"
  },
  "dependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "esbuild": "^0.28.0",
    "jsdom": "^26.0.0"
  },
  "license": "AGPL-3.0-or-later"
}

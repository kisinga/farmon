<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>MajiFlow — {{siteName}} — Site Documentation</title>
<style>{{{css}}}</style>
<style>
.badge-cross { background: #EDE9FE; color: #5B21B6; }
.badge-local { background: #DBEAFE; color: #1E40AF; }
.system-header {
  display: flex; align-items: center; gap: 8px; margin: 18px 0 8px;
  padding: 6px 10px; border-radius: 6px; background: var(--bg-subtle);
}
.system-dot {
  width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0;
}
.link-arrow { color: var(--brand); font-weight: 700; }
</style>
</head>
<body>

<button class="print-button" type="button" onclick="window.print()" title="Use the print dialog's &quot;Save as PDF&quot; destination">Save as PDF</button>

<!-- Header with branding -->
<div class="doc-header">
  <div class="logo">{{{logoSvg}}}</div>
  <div>
    <h1>MajiFlow</h1>
    <div class="subtitle">{{docSubtitle}}</div>
    <div class="pills">
        <span class="pill">{{systemCount}} controller{{#unless singleSystem}}s{{/unless}}</span>
        {{#each componentPills}}<span class="pill">{{this.label}}</span>
        {{/each}}
    </div>
  </div>
</div>

{{#unless singleSystem}}
<h2>Site Topology</h2>
<div class="diagram topology">
{{{compositeTopologySvg}}}
</div>

<h2>Controllers</h2>
<table>
  <thead>
    <tr><th>Controller</th><th>Board</th><th>Device Name</th><th>Tanks</th><th>Pumps</th><th>Valves</th><th>Routes</th></tr>
  </thead>
  <tbody>
{{#each systems}}
    <tr>
      <td><strong>{{this.friendlyName}}</strong></td>
      <td><code>{{this.board}}</code></td>
      <td><code>{{this.deviceName}}</code></td>
      <td>{{this.tankCount}}</td>
      <td>{{this.pumpCount}}</td>
      <td>{{this.valveCount}}</td>
      <td>{{this.routeCount}}</td>
    </tr>
{{/each}}
  </tbody>
</table>
{{/unless}}

{{#if hasLinks}}
<h2>Inter-Controller Links</h2>
<table>
  <thead>
    <tr><th>From Controller</th><th>From Node</th><th></th><th>To Controller</th><th>To Node</th></tr>
  </thead>
  <tbody>
{{#each links}}
    <tr>
      <td>{{this.fromSystemName}}</td>
      <td><code>{{this.fromNode}}</code></td>
      <td class="link-arrow">&rarr;</td>
      <td>{{this.toSystemName}}</td>
      <td><code>{{this.toNode}}</code></td>
    </tr>
{{/each}}
  </tbody>
</table>
{{/if}}

<h2>Routes</h2>
{{#each routeGroups}}
{{#unless ../singleSystem}}
<div class="system-header">
  <div class="system-dot" style="background:{{this.color}}"></div>
  <strong>{{this.friendlyName}}</strong>
  <span style="color:var(--text-muted);font-size:11px;">{{this.routes.length}} route{{#unless this.singleRoute}}s{{/unless}}</span>
</div>
{{/unless}}
<table>
  <thead>
    <tr><th>Route</th><th>Type</th><th>Source Min</th><th>Dest Max</th><th>Max Runtime</th><th>Scope</th></tr>
  </thead>
  <tbody>
{{#each this.routes}}
    <tr>
      <td>{{this.name}}</td>
      <td><span class="badge {{#if this.needsPump}}badge-pump{{else}}badge-gravity{{/if}}">{{#if this.needsPump}}Pumped{{else}}Gravity{{/if}}</span></td>
      <td>{{this.sourceMin}}</td>
      <td>{{this.destMax}}</td>
      <td>{{this.runtime}}</td>
      <td><span class="badge {{#if this.crossSystem}}badge-cross{{else}}badge-local{{/if}}">{{#if this.crossSystem}}Cross-system{{else}}Local{{/if}}</span></td>
    </tr>
{{/each}}
  </tbody>
</table>
{{/each}}

{{#if hasAutomations}}
<h2>Automations</h2>
{{#each automationGroups}}
{{#unless ../singleSystem}}
<div class="system-header">
  <div class="system-dot" style="background:{{this.color}}"></div>
  <strong>{{this.friendlyName}}</strong>
</div>
{{/unless}}
<table>
  <thead>
    <tr><th>Name</th><th>Trigger</th><th>Schedule</th><th>Route</th></tr>
  </thead>
  <tbody>
{{#each this.automations}}
    <tr>
      <td>{{this.name}}</td>
      <td>{{this.trigger}}</td>
      <td>{{this.days}}</td>
      <td>{{this.routeName}}</td>
    </tr>
{{/each}}
  </tbody>
</table>
{{/each}}
{{/if}}

{{#unless singleSystem}}<h2>Controller Details</h2>{{/unless}}
{{#each controllerDetails}}
{{#unless ../singleSystem}}
<div class="system-header">
  <div class="system-dot" style="background:{{this.color}}"></div>
  <strong>{{this.friendlyName}}</strong>
  <span style="color:var(--text-muted);font-size:11px;">Board: <code>{{this.board}}</code> · Device: <code>{{this.deviceName}}</code></span>
</div>
{{/unless}}

{{#if this.topologySvg}}
<h3>Topology</h3>
<div class="diagram topology">
{{{this.topologySvg}}}
</div>
{{/if}}

{{{this.boardPinoutSection}}}

{{#if this.hasPinTable}}
<h3>Pin Connections</h3>
<p style="color:var(--text-muted);font-size:12px;margin-top:-4px;">Wire each entity to the listed connector. Capabilities indicate what the pin supports — e.g. only ADC pins can be used for level sensors.</p>
<table>
  <thead><tr><th>Connector</th><th>Pin</th><th>Entity</th><th>Type</th><th>Field</th><th>Capabilities</th></tr></thead>
  <tbody>
{{#each this.pinTable}}
    <tr>
      <td><code>{{#if this.connector}}{{this.connector}}{{else}}&mdash;{{/if}}</code></td>
      <td><code>{{this.pin}}</code></td>
      <td>{{this.entity}}</td>
      <td>{{this.typeLabel}}</td>
      <td>{{this.fieldLabel}}</td>
      <td>{{#if this.caps}}<code>{{this.caps}}</code>{{else}}&mdash;{{/if}}</td>
    </tr>
{{/each}}
  </tbody>
</table>
{{/if}}

<h3>Timing Parameters</h3>
<table>
  <thead><tr><th>Parameter</th><th>Value</th><th>Description</th></tr></thead>
  <tbody>
    <tr><td>Valve travel time</td><td><strong>{{this.timing.valve_travel_time}}s</strong></td><td>Time allowed for valves to fully open/close</td></tr>
    <tr><td>Flow watchdog</td><td><strong>{{this.timing.flow_watchdog}}s</strong></td><td>No-flow duration before fault/tank-full detection</td></tr>
    <tr><td>Flow confirm</td><td><strong>{{this.timing.flow_confirm}}s</strong></td><td>Time to confirm flow is established after start</td></tr>
    <tr><td>API watchdog</td><td><strong>{{this.timing.api_watchdog}}s</strong></td><td>HA disconnect duration before route is faulted</td></tr>
    <tr><td>Sensor update</td><td><strong>{{this.timing.update_interval}}s</strong></td><td>ADC/sensor polling interval</td></tr>
  </tbody>
</table>

<h3>Home Assistant Entities</h3>
<table>
  <thead><tr><th>Entity</th><th>Type</th><th>Purpose</th></tr></thead>
  <tbody>
{{#each this.routeEntities}}
    <tr><td><code>button.…_start_{{this.index}}</code></td><td>Button</td><td>Start route: {{this.name}}</td></tr>
    <tr><td><code>button.…_stop_{{this.index}}</code></td><td>Button</td><td>Stop route: {{this.name}}</td></tr>
{{/each}}
{{#each this.tankCalEntities}}
    <tr><td><code>number.…_{{this.id}}_cal_empty</code></td><td>Number</td><td>{{this.name}} empty voltage calibration</td></tr>
    <tr><td><code>number.…_{{this.id}}_cal_full</code></td><td>Number</td><td>{{this.name}} full voltage calibration</td></tr>
{{/each}}
    <tr><td><code>switch.…_safety_override</code></td><td>Switch</td><td>Disables <strong>all</strong> runtime safety checks while ON: pre-start level gates, flow watchdog, runtime level stops, max-runtime, API watchdog. Reverts to OFF on reboot. Use only for commissioning or manual recovery.</td></tr>
  </tbody>
</table>

<h3>Firmware Safety</h3>
<div class="safety-grid">
  <div class="safety-card"><strong>Pre-start checks</strong><span>Source/dest level thresholds enforced before every start</span></div>
  <div class="safety-card"><strong>Flow watchdog</strong><span>No-flow fault after {{this.timing.flow_watchdog}}s · Flow confirmed within {{this.timing.flow_confirm}}s</span></div>
  <div class="safety-card"><strong>Runtime level</strong><span>Active on routes with pump-rated sensors · Clean stop on threshold breach</span></div>
  <div class="safety-card"><strong>API watchdog</strong><span>Route faulted if HA disconnects for {{this.timing.api_watchdog}}s</span></div>
  <div class="safety-card" style="border-left-color:#dc2626;"><strong>Safety Override</strong><span>While <code>switch.…_safety_override</code> is ON, every check above is skipped. Switch reverts to OFF on reboot.</span></div>
</div>
{{/each}}

<h2>Firmware Safety Model</h2>
<p>All safety logic runs on the ESP32 — no server dependency. Each controller operates independently with the same state machine and watchdog behavior.</p>

<h3>State Machine</h3>
<div class="state-diagram"><span class="hl">IDLE</span> ──→ <span class="hl">PREPARING</span> ──→ <span class="hl">RUNNING</span> ──→ <span class="hl">STOPPING</span> ──→ <span class="hl">IDLE</span>
          │              │
          └──→ <span class="fault">FAULT</span> ←───┘ ──→ <span class="hl">IDLE</span> (fault_reset)</div>

<h4>Tank Sensor Suppression by State</h4>
<table>
  <thead><tr><th>State</th><th>Tank Readings</th><th>Reason</th></tr></thead>
  <tbody>
    <tr><td><span class="badge badge-idle">IDLE (0)</span></td><td>Valid</td><td>Pump off, pressure settled</td></tr>
    <tr><td><span class="badge badge-info">PREPARING (1)</span></td><td><strong>Suppressed</strong></td><td>Valves moving, minor transients</td></tr>
    <tr><td><span class="badge badge-info">RUNNING (2)</span></td><td><strong>Suppressed</strong></td><td>Pump creates pressure artifacts</td></tr>
    <tr><td><span class="badge badge-info">STOPPING (3)</span></td><td><strong>Suppressed</strong></td><td>Depressurizing, valves closing</td></tr>
    <tr><td><span class="badge badge-fault">FAULT (4)</span></td><td>Valid</td><td>Pump off, valves closed</td></tr>
  </tbody>
</table>

<h3>Pre-flight Checks</h3>
<table>
  <thead><tr><th>Check</th><th>Threshold</th><th>Action</th></tr></thead>
  <tbody>
    <tr><td>Source tank too low</td><td>&lt; 5%</td><td>Reject start (not a fault)</td></tr>
    <tr><td>Dest tank already full</td><td>&gt; 95%</td><td>Reject start (not a fault)</td></tr>
    <tr><td>System not IDLE</td><td>state ≠ 0</td><td>Reject start</td></tr>
    <tr><td>Invalid route ID</td><td>Out of range</td><td>Reject start</td></tr>
  </tbody>
</table>

<h3>Runtime Safety Checks</h3>
<table>
  <thead><tr><th>#</th><th>Check</th><th>Fault Code</th><th>Threshold</th></tr></thead>
  <tbody>
    <tr><td>1</td><td>Flow watchdog</td><td><span class="badge badge-fault">no_flow (1)</span></td><td>No pulses for flow_watchdog</td></tr>
    <tr><td>2</td><td>Per-route max runtime</td><td><span class="badge badge-fault">max_runtime (2)</span></td><td>Route-specific max_runtime_s ceiling</td></tr>
    <tr><td>3</td><td>API watchdog</td><td><span class="badge badge-fault">api_lost (3)</span></td><td>HA disconnected for api_watchdog</td></tr>
  </tbody>
</table>

<h3>Stop Reasons</h3>
<table>
  <thead><tr><th>Code</th><th>Reason</th><th>Trigger</th></tr></thead>
  <tbody>
    <tr><td>0</td><td>None</td><td>Initial state</td></tr>
    <tr><td>1</td><td>Manual stop</td><td>User called pump_stop</td></tr>
    <tr><td>2</td><td>Tank full</td><td>Flow confirmed then stopped (backpressure)</td></tr>
    <tr><td>3</td><td>No flow</td><td>Fault: no pulses after confirmation window</td></tr>
    <tr><td>4</td><td>Max runtime</td><td>Fault: route exceeded time limit</td></tr>
    <tr><td>5</td><td>API lost</td><td>Fault: HA connection lost</td></tr>
  </tbody>
</table>

<h3>Fault vs Clean Stop</h3>
<div class="safety-grid">
  <div class="safety-card" style="border-left-color:#dc2626;">
    <strong>Fault Response</strong>
    <span>Kill pump → HA event (<code>esphome.pump_fault</code>) → Close all valves → <strong>FAULT</strong> (latched)<br>Requires <code>fault_reset</code> service call from HA to return to IDLE.</span>
  </div>
  <div class="safety-card" style="border-left-color:#16a34a;">
    <strong>Clean Stop Response</strong>
    <span>HA event (<code>esphome.pump_stopped</code>) → Kill pump → Depressurize 2s → Close all valves → <strong>IDLE</strong></span>
  </div>
</div>

<h3>Tank-to-Tank Overflow Protection</h3>
<ol>
  <li><strong>Pre-start check</strong>: dest tank &gt; 95% → reject start</li>
  <li><strong>Per-route max_runtime_s</strong>: sized to tank capacity (hard fault if exceeded)</li>
  <li><strong>Hardware float switch</strong> (REQUIRED): high-level switch on every destination tank — independent of ESP32 software</li>
</ol>

<h3>Responsibility Split</h3>
<div class="resp-grid">
  <div class="resp-col">
    <strong>ESP32 (On-Device)</strong>
    <ul>
      <li>State machine + valve sequencing + pump relay</li>
      <li>Flow watchdog (unconditional on every route)</li>
      <li>Per-route max runtime + API watchdog</li>
      <li>Pre-flight validation (source/dest levels)</li>
      <li>Pump relay guard (blocks direct toggle)</li>
      <li>Tank sensor suppression during pump operation</li>
      <li>HA event notifications (pump_stopped, pump_fault)</li>
    </ul>
  </div>
  <div class="resp-col">
    <strong>Home Assistant (Server)</strong>
    <ul>
      <li>Operating mode selection</li>
      <li>Active threshold resolution</li>
      <li>Auto-refill trigger + conservation stop</li>
      <li>Duration timer (user-configurable)</li>
      <li>Dashboard, notifications, logging</li>
    </ul>
  </div>
</div>

<h3>HA Event Notifications</h3>
<table>
  <thead><tr><th>Event Type</th><th>Data Fields</th><th>When</th></tr></thead>
  <tbody>
    <tr><td><code>stopped</code></td><td>route, reason</td><td>Clean stop (manual, tank full)</td></tr>
    <tr><td><code>fault</code></td><td>route, fault</td><td>Any fault condition</td></tr>
  </tbody>
</table>

{{#if hasFlowSensors}}
<h3>Sensor Fault Detection</h3>
<p>Each flow sensor has built-in fault detection. When the pump is RUNNING and flow was previously confirmed (&gt; 0.5 L/min), 3 consecutive zero readings trigger a <code>sensor_fault</code> binary sensor in HA. This is distinct from no_flow (never established) — sensor fault means flow was confirmed then the sensor stopped reporting.</p>
{{/if}}

<div class="installation">
<h2>Installation Guidelines</h2>

{{#if hasFlowSensors}}
<h3>Flow Sensors</h3>
<h4>Placement — The 10D/5D Rule</h4>
<p>Flow sensors require straight, undisturbed pipe upstream and downstream for accurate readings:</p>
<ul>
  <li><strong>10D upstream</strong>: 10 pipe diameters of straight pipe before the sensor</li>
  <li><strong>5D downstream</strong>: 5 pipe diameters of straight pipe after the sensor</li>
</ul>
<p>For a 1" (25mm) pipe: 250mm straight before, 125mm straight after.</p>

<h4>Float Valve Requirement</h4>
<p>A float valve <strong>must</strong> be installed upstream of each flow sensor on routes filling a destination tank. When the tank is full, the float valve closes and flow drops to zero — this is how MajiFlow detects tank-full and triggers a clean stop via the flow watchdog.</p>

<h4>Mounting &amp; Electrical</h4>
<ul>
  <li>Mount <strong>horizontally</strong> with the impeller axis vertical; arrow matches flow direction</li>
  <li>Use shielded cable for runs &gt; 2m · Pull-up resistor (10kΩ to 3.3V) recommended</li>
</ul>
{{/if}}

{{#if hasValves}}
<h3>Valves</h3>
<ul>
  <li>Mount <strong>horizontally</strong> or with the actuator <strong>above</strong> the pipe</li>
  <li>Default travel time: <strong>15 seconds</strong></li>
  <li>2-wire control: one wire for OPEN, one for CLOSE. <strong>Never energize both simultaneously</strong> — ESPHome interlocks prevent this</li>
  <li>Wire gauge: 18 AWG minimum for runs up to 15m; 16 AWG for longer runs</li>
</ul>
{{/if}}

{{#if hasTanks}}
<h3>Tank Level Sensors</h3>
<p>Analog pressure sensors at the tank bottom measure water column height. Mount at the <strong>lowest point</strong> of the tank.</p>
<p>Calibrate via Home Assistant: set <strong>Cal Empty (V)</strong> and <strong>Cal Full (V)</strong> number entities.</p>
<p>Tank readings are <strong>suppressed during pump operation</strong> to avoid pressure artifacts.</p>
{{/if}}

<h3>General Notes</h3>
<ul>
  <li><strong>Pipe sizing</strong>: Match pipe diameter to expected flow rates</li>
  <li><strong>Pressure regulators</strong>: Install upstream if mains pressure exceeds 6 bar</li>
  <li><strong>Check valves</strong>: Non-return valves on tank inlet lines</li>
  <li><strong>Strainers</strong>: Install upstream of flow sensors to prevent debris fouling</li>
  <li><strong>Float switches</strong>: Required on every destination tank as hardware safety interlock</li>
</ul>

</div>

<div class="installation">
<h2>Power &amp; Wiring</h2>

{{md "wiring/at-a-glance"}}

{{md "wiring/dc-power-supply"}}

{{md "wiring/dc-cable-runs"}}

{{md "wiring/pump-branch"}}

{{md "wiring/common-mistakes"}}
</div>

<div class="footer">
  <div class="brand">{{{logoSvgSmall}}} MajiFlow</div>
  <div>{{siteName}} · {{systemCount}} controllers · Generated {{genDate}}</div>
</div>

</body>
</html>

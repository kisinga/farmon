-      id,
-      stream: "stdout",
-      text: chunk.toString("utf-8"),
-    } satisfies SerialOutputEvent);
-  });
-
-  proc.stderr!.on("data", (chunk: Buffer) => {
-    win.webContents.send("serial:output", {
-      id,
-      stream: "stderr",
-      text: chunk.toString("utf-8"),

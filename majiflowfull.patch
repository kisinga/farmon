-        recordFailure(backend);
-        throw err;
-      }
-    );
-
-    return { handle, result: wrappedResult };
-  } catch (err) {
-    if (opts?.idempotencyKey) clearInFlight(opts.idempotencyKey);
-    throw err;
-  }
-}
